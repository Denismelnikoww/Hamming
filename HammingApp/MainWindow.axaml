<Window
    x:Class="HammingApp.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:HammingApp.Models"
    xmlns:vm="using:HammingApp.ViewModels"
    Title="Код Хэмминга"
    Width="1300"
    Height="1000"
    x:DataType="vm:MainWindowViewModel"
    Background="#16181D"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <ScrollViewer>

        <StackPanel Margin="30" Spacing="24">

            <!--  HEADER  -->

            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="6">

                    <TextBlock
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Алгоритм Хэмминга" />

                    <TextBlock Foreground="#9CA3AF" Text="Пошаговое кодирование и декодирование" />

                </StackPanel>

            </Border>

            <!--  ENCODE INPUT  -->

            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="16">

                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Кодирование" />

                    <TextBox
                        Padding="12"
                        Background="#252932"
                        BorderBrush="#323844"
                        CornerRadius="10"
                        Foreground="White"
                        Text="{Binding InputText}"
                        Watermark="Введите текст или биты" />

                    <CheckBox
                        Content="Ввод является бинарной строкой"
                        Foreground="White"
                        IsChecked="{Binding IsBinary}" />

                    <Button
                        Height="42"
                        MinWidth="180"
                        Padding="24,0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#3B82F6"
                        BorderThickness="0"
                        Command="{Binding EncodeCommand}"
                        Content="Построить код"
                        CornerRadius="10"
                        FontWeight="SemiBold" />

                </StackPanel>

            </Border>

            <!--  INITIAL TABLE  -->

            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="14">

                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="1. Вставка контрольных битов" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto">

                        <StackPanel Spacing="8">

                            <!--  HEADERS  -->

                            <StackPanel Orientation="Horizontal">

                                <Border Width="120" />

                                <ItemsControl ItemsSource="{Binding InitialTable.Headers}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border
                                                Width="40"
                                                Height="40"
                                                Background="#2D3340"
                                                BorderBrush="#3A4150"
                                                BorderThickness="1">

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Text="{Binding}" />

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                            <!--  ROWS  -->

                            <ItemsControl ItemsSource="{Binding InitialTable.Rows}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate x:DataType="models:HammingVisualRow">

                                        <StackPanel Orientation="Horizontal">

                                            <Border
                                                Width="120"
                                                Height="40"
                                                Background="#252932"
                                                BorderBrush="#3A4150"
                                                BorderThickness="1">

                                                <TextBlock
                                                    Margin="10,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Text="{Binding Name}" />

                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Values}">

                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border
                                                            Width="40"
                                                            Height="40"
                                                            Background="#2D3340"
                                                            BorderBrush="#3A4150"
                                                            BorderThickness="1">

                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="White"
                                                                Text="{Binding}" />

                                                        </Border>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </StackPanel>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </ScrollViewer>

                </StackPanel>

            </Border>

            <!--  MATRIX  -->

            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="14">

                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="2. Матрица преобразования" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto">

                        <StackPanel Spacing="8">

                            <!--  HEADERS  -->

                            <StackPanel Orientation="Horizontal">

                                <Border Width="120" />

                                <ItemsControl ItemsSource="{Binding MatrixTable.Headers}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border
                                                Width="40"
                                                Height="40"
                                                Background="#2D3340"
                                                BorderBrush="#3A4150"
                                                BorderThickness="1">

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Text="{Binding}" />

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                            <!--  ROWS  -->

                            <ItemsControl ItemsSource="{Binding MatrixTable.Rows}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate x:DataType="models:HammingVisualRow">

                                        <StackPanel Orientation="Horizontal">

                                            <Border
                                                Width="120"
                                                Height="40"
                                                Background="#252932"
                                                BorderBrush="#3A4150"
                                                BorderThickness="1">

                                                <TextBlock
                                                    Margin="10,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Text="{Binding Name}" />

                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Values}">

                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border
                                                            Width="40"
                                                            Height="40"
                                                            Background="#2D3340"
                                                            BorderBrush="#3A4150"
                                                            BorderThickness="1">

                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="White"
                                                                Text="{Binding}" />

                                                        </Border>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </StackPanel>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </ScrollViewer>

                </StackPanel>

            </Border>

            <!--  CALCULATIONS  -->

            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="12">

                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="3. Вычисление контрольных битов" />

                    <ItemsControl ItemsSource="{Binding Calculations}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate x:DataType="models:ParityCalculation">

                                <Border
                                    Padding="12"
                                    Background="#252932"
                                    CornerRadius="10">

                                    <StackPanel Spacing="4">

                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#60A5FA"
                                            Text="{Binding Name}" />

                                        <TextBlock
                                            Foreground="White"
                                            Text="{Binding Formula}"
                                            TextWrapping="Wrap" />

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>

            <!--  FINAL CODE  -->

            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="12">

                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="4. Итоговый код" />

                    <Border
                        Padding="16"
                        Background="#252932"
                        CornerRadius="10">

                        <TextBox
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="#34D399"
                            IsEnabled="True"
                            IsReadOnly="True"
                            Text="{Binding FinalCode}"
                            TextWrapping="Wrap" />

                    </Border>

                </StackPanel>

            </Border>

            <!--  DECODE  -->

            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="16">

                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Декодирование и синдромы" />

                    <TextBox
                        Padding="12"
                        Background="#252932"
                        BorderBrush="#323844"
                        CornerRadius="10"
                        Foreground="White"
                        Text="{Binding DecodeInput}"
                        Watermark="Введите код Хэмминга" />

                    <Button
                        Height="42"
                        MinWidth="180"
                        Padding="24,0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#EF4444"
                        BorderThickness="0"
                        Command="{Binding DecodeCommand}"
                        Content="Построить синдромы"
                        CornerRadius="10"
                        FontWeight="SemiBold" />

                    <!--  SYNDROME TABLE  -->

                    <ScrollViewer HorizontalScrollBarVisibility="Auto">

                        <StackPanel Spacing="8">

                            <!--  HEADERS  -->

                            <StackPanel Orientation="Horizontal">

                                <Border Width="120" />

                                <ItemsControl ItemsSource="{Binding SyndromeTable.Headers}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border
                                                Width="40"
                                                Height="40"
                                                Background="#2D3340"
                                                BorderBrush="#3A4150"
                                                BorderThickness="1">

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Text="{Binding}" />

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                            <!--  ROWS  -->

                            <ItemsControl ItemsSource="{Binding SyndromeTable.Rows}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate x:DataType="models:HammingVisualRow">

                                        <StackPanel Orientation="Horizontal">

                                            <Border
                                                Width="120"
                                                Height="40"
                                                Background="#252932"
                                                BorderBrush="#3A4150"
                                                BorderThickness="1">

                                                <TextBlock
                                                    Margin="10,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Text="{Binding Name}" />

                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Values}">

                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border
                                                            Width="40"
                                                            Height="40"
                                                            Background="#2D3340"
                                                            BorderBrush="#3A4150"
                                                            BorderThickness="1">

                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="White"
                                                                Text="{Binding}" />

                                                        </Border>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </StackPanel>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </ScrollViewer>

                    <!--  SYNDROME RESULTS  -->

                    <ItemsControl ItemsSource="{Binding SyndromeRows}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate x:DataType="models:SyndromeRow">

                                <Border
                                    Padding="12"
                                    Background="#252932"
                                    CornerRadius="10">

                                    <StackPanel Spacing="4">

                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#F87171"
                                            Text="{Binding Name}" />

                                        <TextBlock Foreground="White" Text="{Binding Result}" />

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <!--  RESULT  -->

                    <Border
                        Padding="16"
                        Background="#252932"
                        CornerRadius="10">

                        <StackPanel Spacing="8">

                            <TextBlock
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="Матрица синдромов" />

                            <TextBlock
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#FBBF24"
                                Text="{Binding SyndromeBits}" />

                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="#34D399"
                                Text="{Binding DecodeResult}" />

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Window>