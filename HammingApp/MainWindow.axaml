<Window
    x:Class="HammingApp.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:HammingApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:HammingApp.ViewModels"
    Title="Код Хэмминга"
    Width="1100"
    Height="760"
    MinWidth="900"
    MinHeight="650"
    x:DataType="vm:MainWindowViewModel"
    Background="#16181D"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!--  ТОЛЬКО БАЗОВЫЕ СТИЛИ БЕЗ HOVER / TRANSITIONS  -->
    <Window.Styles>

        <Style Selector="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#D1D5DB" />
        </Style>

    </Window.Styles>

    <ScrollViewer>

        <StackPanel Margin="30" Spacing="24">

            <!--  HEADER  -->
            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="6">

                    <TextBlock
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Код Хэмминга" />

                    <TextBlock
                        FontSize="15"
                        Foreground="#9CA3AF"
                        Text="Кодирование, синдромы и поиск ошибок" />

                </StackPanel>

            </Border>

            <!--  INPUT  -->
            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="16">

                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Входные данные" />

                    <TextBlock Foreground="#B8BDC7" Text="Введите текст или бинарную строку" />

                    <TextBox
                        Padding="12"
                        Background="#252932"
                        BorderBrush="#323844"
                        CornerRadius="10"
                        FontSize="15"
                        Text="{Binding InputText}" />

                    <CheckBox Content="Ввод является бинарной строкой" IsChecked="{Binding IsBinary}" />

                    <Button
                        Height="42"
                        MinWidth="170"
                        Padding="24,0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#3B82F6"
                        BorderThickness="0"
                        Command="{Binding EncodeCommand}"
                        Content="Закодировать"
                        CornerRadius="10"
                        FontWeight="SemiBold" />

                </StackPanel>

            </Border>

            <!--  RESULT  -->
            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="18">

                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Результат кодирования" />

                    <StackPanel Spacing="8">

                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#D1D5DB"
                            Text="Исходные биты" />

                        <TextBox
                            Padding="12"
                            Background="#252932"
                            BorderBrush="#323844"
                            CornerRadius="10"
                            IsReadOnly="True"
                            Text="{Binding SourceBits}" />

                    </StackPanel>

                    <StackPanel Spacing="8">

                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#D1D5DB"
                            Text="Закодированное сообщение" />

                        <TextBox
                            Padding="12"
                            Background="#252932"
                            BorderBrush="#323844"
                            CornerRadius="10"
                            IsReadOnly="True"
                            Text="{Binding EncodedResult}" />

                    </StackPanel>

                </StackPanel>

            </Border>

            <!--  TABLE  -->
            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="18">

                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Таблица Хэмминга" />

                    <Border
                        Padding="14"
                        Background="#252932"
                        CornerRadius="12">

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

                            <StackPanel Spacing="12">

                                <!--  Позиции  -->
                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <TextBlock
                                        Width="120"
                                        FontWeight="Bold"
                                        Foreground="#D1D5DB"
                                        Text="Позиция" />

                                    <ItemsControl ItemsSource="{Binding SyndromeRows}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Width="42"
                                                    Height="42"
                                                    Background="#2D3340"
                                                    BorderBrush="#3A4150"
                                                    BorderThickness="1"
                                                    CornerRadius="8">

                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="White"
                                                        Text="{Binding Position}" />

                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>

                                <!--  Значения  -->
                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <TextBlock
                                        Width="120"
                                        FontWeight="Bold"
                                        Foreground="#D1D5DB"
                                        Text="Значение" />

                                    <ItemsControl ItemsSource="{Binding SyndromeRows}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Width="42"
                                                    Height="42"
                                                    Background="#2D3340"
                                                    BorderBrush="#3A4150"
                                                    BorderThickness="1"
                                                    CornerRadius="8">

                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontWeight="Bold"
                                                        Foreground="#60A5FA"
                                                        Text="{Binding Value}" />

                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>

                                <!--  Контрольные  -->
                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <TextBlock
                                        Width="120"
                                        FontWeight="Bold"
                                        Foreground="#D1D5DB"
                                        Text="Контрольный" />

                                    <ItemsControl ItemsSource="{Binding SyndromeRows}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Width="42"
                                                    Height="42"
                                                    Background="#2D3340"
                                                    BorderBrush="#3A4150"
                                                    BorderThickness="1"
                                                    CornerRadius="8">

                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontWeight="Bold"
                                                        Foreground="#34D399"
                                                        Text="{Binding IsControlBit, Converter={x:Static converters:BooleanToPlusMinusConverter.Instance}}" />

                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>

                            </StackPanel>

                        </ScrollViewer>

                    </Border>

                </StackPanel>

            </Border>

            <!--  CHECK  -->
            <Border
                Padding="24"
                Background="#1E222A"
                CornerRadius="14">

                <StackPanel Spacing="16">

                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Проверка ошибки" />

                    <TextBox
                        Padding="12"
                        Background="#252932"
                        BorderBrush="#323844"
                        CornerRadius="10"
                        Text="{Binding CheckInput}"
                        Watermark="Введите код Хэмминга" />

                    <Button
                        Height="42"
                        MinWidth="170"
                        Padding="24,0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#10B981"
                        BorderThickness="0"
                        Command="{Binding CheckErrorCommand}"
                        Content="Проверить"
                        CornerRadius="10"
                        FontWeight="SemiBold" />

                    <Border
                        Padding="14"
                        Background="#252932"
                        CornerRadius="10">

                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding ErrorResult}" />

                    </Border>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Window>